---
import HeroSection from "../components/HeroSection.astro";
import ItemCard from "../components/ItemCard.astro";
import Layout from "../layouts/Layout.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<HeroSection />

	<section class="py-6 px-6 text-center">
		<div>
			<h2 class="text-white text-3xl font-semibold mb-4">
				Construyendo la siguiente Generación
			</h2>
			<p>
				Nuestra API está diseñada para solucionar los complejos problemas de
				backend con sencilles, una elegante solución que escala automáticamente
			</p>
		</div>

		<div class="flex flex-wrap gap-8 py-12">
			<ItemCard
				icon="mdi:gauge-full"
				title="Alto Rendimiento"
				description="Nodos distribuidos globalmente con latencia ultrabaja que garantizan tiempos de respuesta inferiores a 20 ms en cualquier lugar."
			/>
			<ItemCard
				icon="mdi:chart-areaspline"
				title="Escalabilidad infinita"
				description="De 1 a 1000 millones de solicitudes. Nuestra arquitectura de escalado automático gestiona su crecimiento sin problemas."
			/>
			<ItemCard
				icon="mdi:clock-check-outline"
				title="SLA de tiempo de actividad del 99,99 %"
				description="Fiabilidad en la que puede confiar. Sistemas de conmutación por error redundantes entre múltiples proveedores de nube."
			/>
		</div>
	</section>

	<section class="p-6">
		<div class="bg-gradient-to-br from-blue-600 to-blue-700 text-center flex flex-col items-center gap-10 p-12 rounded-lg text-white">
			<div>
				<h2 class="text-3xl font-semibold mb-6">¿Preparado para construir el futuro?</h2>
				<p class="opacity-90s max-w-2xl">Únite a millones de desarrolladores que construyen productos. Conecta tu aplicación a nuestra API en menos de 60 seconds</p>
			</div>
			<div class="flex gap-8">
				<button class="text-blue-700 bg-white font-bold flex items-center px-8 py-5 rounded-lg gap-2">Comienza Gratis</button>
				<button class="bg-transparent text-white font-bold flex items-center px-8 py-5 rounded-lg gap-2 ring-2 ring-blue-600">Contactanos</button>
			</div>
		</div>
	</section>
</Layout>
