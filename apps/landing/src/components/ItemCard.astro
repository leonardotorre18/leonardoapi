---
import { Icon } from "astro-icon/components"

interface Props {
  description: string
  title: string
  icon: string
}

const { description, title, icon } = Astro.props
---


<div class="flex flex-col gap-3 flex-1 ring-2 bg-slate-950 ring-slate-900 rounded-lg p-6 text-left items-start">

  <div class="bg-slate-900 rounded-lg p-3">
    <Icon name={icon} size={32} />
  </div>

  <h3 class="text-lg text-white font-semibold">{ title }</h3>

  <p>{ description }</p>

</div>